module

public import DiscreteHudson.Sums
public import Mathlib.Algebra.Group.Subgroup.Lattice

/-!
# The discrete Hudson theorem

For odd `d`, write `e(a) = ⟨ψ|A(a)|ψ⟩` and `N = ‖ψ‖²`.

**Non-negative implies stabilizer** (`isStabilizerState_of_nonneg`). Each `A(a)` is a
self-adjoint involution, so `e(a)` is real and `e(a) ≤ N`, with equality only if `A(a) ψ = ψ`.
Also `Σ_a e(a) = dⁿ N` and `Σ_a e(a)² = dⁿ N²`. If every `e(a) ≥ 0`, then
`Σ_a e(a) (N - e(a)) = 0` with non-negative terms, so `e(a) ∈ {0, N}`, and the set `S` where
`e = N` has `dⁿ` points. For `a, a₀ ∈ S`, `A(a) A(a₀) = (phase) w(2(a - a₀))` fixes `ψ`, so `ψ` is
an eigenvector of every Weyl operator in the subgroup `M` generated by the `2(a - a₀)`. Eigenvectors
of two Weyl operators force them to commute, so `M` is isotropic. `|M| ≥ |S| = dⁿ` because `2` is
invertible, and `|M| ≤ dⁿ` because `Σ_v |⟨ψ|w(v)|ψ⟩|² = dⁿ N²` while each `v ∈ M` contributes
`N²`.

**Stabilizer implies non-negative** (`wigner_nonneg_of_isStabilizerState`). The same identity
forces `⟨ψ|w(v)|ψ⟩ = 0` off `M`. On an isotropic `M` the eigenvalues form a character, so
`e(a) = d⁻ⁿ Σ_{m ∈ M} ω([a, m]) ⟨ψ|w(m)|ψ⟩` is `N/dⁿ` times a character sum over `M`, which is
`|M|` or `0` (Gross, Lemma 9).

This route avoids the discrete Bochner theorem, Clifford covariance and the similarity lemma
used in Gross's Section III.
-/

@[expose] public section

open Finset
open scoped ComplexOrder

namespace DiscreteHudson

variable {d n : ℕ} [NeZero d]

local notation "ω" => (ZMod.stdAddChar : AddChar (ZMod d) ℂ)

/-! ### Norms -/

/-- `‖f‖² = Σ_x |f(x)|²`. -/
noncomputable def nsq (f : Config d n → ℂ) : ℝ := ∑ x, Complex.normSq (f x)

lemma sum_star_mul_self (f : Config d n → ℂ) : ∑ x, star (f x) * f x = (nsq f : ℂ) := by
  simp only [nsq, Complex.ofReal_sum, Complex.normSq_eq_conj_mul_self]
  rfl

lemma nsq_nonneg (f : Config d n → ℂ) : 0 ≤ nsq f :=
  Finset.sum_nonneg fun _ _ => Complex.normSq_nonneg _

lemma nsq_eq_zero {f : Config d n → ℂ} : nsq f = 0 ↔ f = 0 := by
  rw [nsq, Finset.sum_eq_zero_iff_of_nonneg fun _ _ => Complex.normSq_nonneg _]
  simp only [mem_univ, true_implies, Complex.normSq_eq_zero, funext_iff, Pi.zero_apply]

lemma nsq_pos {f : Config d n → ℂ} (hf : f ≠ 0) : 0 < nsq f :=
  lt_of_le_of_ne (nsq_nonneg f) (Ne.symm (mt nsq_eq_zero.1 hf))

lemma weyl_smul (v : PhaseSpace d n) (c : ℂ) (ψ : Config d n → ℂ) :
    weyl v (c • ψ) = c • weyl v ψ := by
  funext x; simp only [weyl, Pi.smul_apply, smul_eq_mul]; ring

omit [NeZero d] in
lemma smul_cancel {ψ : Config d n → ℂ} (hψ : ψ ≠ 0) {c₁ c₂ : ℂ} (h : c₁ • ψ = c₂ • ψ) :
    c₁ = c₂ := by
  obtain ⟨x, hx⟩ := Function.ne_iff.1 hψ
  have := congrFun h x
  simp only [Pi.smul_apply, smul_eq_mul] at this
  exact mul_right_cancel₀ hx this

/-- An eigenvalue of a Weyl operator has modulus one. -/
lemma eigen_mul_star {v : PhaseSpace d n} {ψ : Config d n → ℂ} (hψ : ψ ≠ 0) {c : ℂ}
    (h : weyl v ψ = c • ψ) : c * star c = 1 := by
  have h1 := norm_weyl v ψ
  rw [h] at h1
  simp only [Pi.smul_apply, smul_eq_mul, star_mul'] at h1
  have h2 : ∑ x, star c * star (ψ x) * (c * ψ x) = (c * star c) * ∑ x, star (ψ x) * ψ x := by
    rw [Finset.mul_sum]; refine Finset.sum_congr rfl fun x _ => ?_; ring
  rw [h2, sum_star_mul_self] at h1
  have hN : (nsq ψ : ℂ) ≠ 0 := by exact_mod_cast (nsq_pos hψ).ne'
  calc c * star c = (c * star c) * nsq ψ / nsq ψ := by field_simp
    _ = 1 := by rw [h1, div_self hN]

/-- `⟨ψ|w(v)|ψ⟩` when `ψ` is an eigenvector of `w(v)`. -/
lemma inner_weyl_of_eigen {v : PhaseSpace d n} {ψ : Config d n → ℂ} {c : ℂ}
    (h : weyl v ψ = c • ψ) : ∑ x, star (ψ x) * weyl v ψ x = c * nsq ψ := by
  rw [h, ← sum_star_mul_self, Finset.mul_sum]
  refine Finset.sum_congr rfl fun x _ => ?_
  simp only [Pi.smul_apply, smul_eq_mul]; ring

/-! ### The phase point operators -/

lemma star_inner_phasePoint (hd : Odd d) (a : PhaseSpace d n) (ψ : Config d n → ℂ) :
    star (∑ x, star (ψ x) * phasePoint a ψ x) = ∑ x, star (ψ x) * phasePoint a ψ x := by
  rw [star_sum, inner_phasePoint hd a ψ ψ]
  refine Finset.sum_congr rfl fun x _ => ?_
  rw [star_mul', star_star, mul_comm]

lemma norm_sub_phasePoint (hd : Odd d) (a : PhaseSpace d n) (ψ : Config d n → ℂ) :
    ∑ x, star (ψ x - phasePoint a ψ x) * (ψ x - phasePoint a ψ x) =
      2 * ∑ x, star (ψ x) * ψ x - 2 * ∑ x, star (ψ x) * phasePoint a ψ x := by
  have h1 := inner_phasePoint hd a ψ ψ
  have h2 := inner_phasePoint hd a ψ (phasePoint a ψ)
  rw [phasePoint_phasePoint_self hd] at h2
  have h3 : ∀ x, star (ψ x - phasePoint a ψ x) * (ψ x - phasePoint a ψ x) =
      star (ψ x) * ψ x - star (ψ x) * phasePoint a ψ x - star (phasePoint a ψ x) * ψ x +
        star (phasePoint a ψ x) * phasePoint a ψ x := by
    intro x; rw [star_sub]; ring
  simp_rw [h3, Finset.sum_add_distrib, Finset.sum_sub_distrib]
  rw [← h1, ← h2]
  ring

/-! ### Non-negative implies stabilizer -/

theorem isStabilizerState_of_nonneg (hd : Odd d) (ψ : Config d n → ℂ) (hψ : ψ ≠ 0)
    (h : ∀ a, 0 ≤ wigner ψ a) : IsStabilizerState ψ := by
  classical
  set N := nsq ψ with hNdef
  have hN : 0 < N := nsq_pos hψ
  have hdn : (0 : ℝ) < (d : ℝ) ^ n := pow_pos (Nat.cast_pos.2 (NeZero.pos d)) n
  set e : PhaseSpace d n → ℂ := fun a => ∑ x, star (ψ x) * phasePoint a ψ x with he_def
  set r : PhaseSpace d n → ℝ := fun a => (e a).re with hr_def
  have he : ∀ a, e a = (r a : ℂ) := fun a =>
    (Complex.conj_eq_iff_re.1 (star_inner_phasePoint hd a ψ)).symm
  have he' : ∀ a, ∑ x, star (ψ x) * phasePoint a ψ x = (r a : ℂ) := he
  -- `0 ≤ r a`
  have hr0 : ∀ a, 0 ≤ r a := by
    intro a
    have hw : wigner ψ a = ((((d : ℝ) ^ n)⁻¹ * r a : ℝ) : ℂ) := by
      rw [wigner, show ∑ x, star (ψ x) * phasePoint a ψ x = e a from rfl, he a]; push_cast; rfl
    have := h a
    rw [hw, Complex.zero_le_real] at this
    exact (mul_nonneg_iff_of_pos_left (inv_pos.2 hdn)).1 this
  -- `2N - 2 r a = ‖ψ - A(a)ψ‖²`
  have hnorm : ∀ a, 2 * N - 2 * r a = nsq (fun x => ψ x - phasePoint a ψ x) := by
    intro a
    have h1 := norm_sub_phasePoint hd a ψ
    rw [sum_star_mul_self (fun x => ψ x - phasePoint a ψ x), sum_star_mul_self, he' a] at h1
    exact_mod_cast h1.symm
  have hle : ∀ a, r a ≤ N := fun a => by
    have h1 := hnorm a; have h2 := nsq_nonneg (fun x => ψ x - phasePoint a ψ x); linarith
  have hfix : ∀ a, r a = N → phasePoint a ψ = ψ := by
    intro a ha
    have h1 : nsq (fun x => ψ x - phasePoint a ψ x) = 0 := by rw [← hnorm a, ha]; ring
    have h2 := congrFun (nsq_eq_zero.1 h1)
    funext x; have := h2 x; simp only [Pi.zero_apply, sub_eq_zero] at this; exact this.symm
  -- the two sums
  have hsum : ∑ a, r a = (d : ℝ) ^ n * N := by
    have h1 := sum_inner_phasePoint hd ψ
    rw [sum_star_mul_self] at h1
    simp_rw [he'] at h1
    exact_mod_cast h1
  have hsq : ∑ a, r a ^ 2 = (d : ℝ) ^ n * N ^ 2 := by
    have h1 := sum_inner_phasePoint_sq hd ψ
    rw [sum_star_mul_self] at h1
    simp_rw [he', Complex.star_def, Complex.conj_ofReal] at h1
    have h2 : ((∑ a, r a ^ 2 : ℝ) : ℂ) = (((d : ℝ) ^ n * N ^ 2 : ℝ) : ℂ) := by
      calc ((∑ a, r a ^ 2 : ℝ) : ℂ) = ∑ a, (r a : ℂ) * (r a : ℂ) := by push_cast; simp_rw [sq]
        _ = (d : ℂ) ^ n * ((N : ℂ) * (N : ℂ)) := h1
        _ = _ := by push_cast; ring
    exact_mod_cast h2
  -- every value is `0` or `N`
  have hzero : ∑ a, r a * (N - r a) = 0 := by
    have : ∑ a, r a * (N - r a) = N * ∑ a, r a - ∑ a, r a ^ 2 := by
      rw [Finset.mul_sum, ← Finset.sum_sub_distrib]
      refine Finset.sum_congr rfl fun a _ => ?_; ring
    rw [this, hsum, hsq]; ring
  have hval : ∀ a, r a = 0 ∨ r a = N := by
    intro a
    have h1 := (Finset.sum_eq_zero_iff_of_nonneg (fun a _ =>
      mul_nonneg (hr0 a) (sub_nonneg.2 (hle a)))).1 hzero a (mem_univ a)
    rcases mul_eq_zero.1 h1 with h2 | h2
    · exact Or.inl h2
    · exact Or.inr (sub_eq_zero.1 h2).symm
  -- the set `S`
  set S := (univ : Finset (PhaseSpace d n)).filter (fun a => r a = N) with hS
  have hScard : S.card = d ^ n := by
    have h1 : ∑ a, r a = ∑ a ∈ S, N := by
      rw [Finset.sum_filter]
      refine Finset.sum_congr rfl fun a _ => ?_
      rcases hval a with h2 | h2
      · rw [h2, ite_eq_right_of_eq_false _ _ (eq_false (by rw [eq_comm]; exact hN.ne'))]
      · rw [ite_eq_left_of_eq_true _ _ (eq_true h2), h2]
    rw [hsum, Finset.sum_const, nsmul_eq_mul] at h1
    have h2 : ((S.card : ℕ) : ℝ) = ((d ^ n : ℕ) : ℝ) := by
      push_cast
      exact (mul_right_cancel₀ hN.ne' h1).symm
    exact_mod_cast h2
  have hSne : S.Nonempty := by
    rw [← Finset.card_pos, hScard]; exact pow_pos (NeZero.pos d) n
  obtain ⟨a₀, ha₀⟩ := hSne
  have hfixS : ∀ a ∈ S, phasePoint a ψ = ψ := fun a ha => hfix a (Finset.mem_filter.1 ha).2
  -- the subgroup `M`
  set f : PhaseSpace d n → PhaseSpace d n := fun a => (2 : ZMod d) • (a - a₀) with hf
  set M := AddSubgroup.closure (f '' (S : Set (PhaseSpace d n))) with hM
  have hgen : ∀ a ∈ S, ∃ c : ℂ, weyl (f a) ψ = c • ψ := by
    intro a ha
    have h1 := phasePoint_phasePoint hd a a₀ ψ
    rw [hfixS a₀ ha₀, hfixS a ha] at h1
    refine ⟨ω (-(2 * symp a₀ a)), ?_⟩
    conv_rhs => rw [h1]
    rw [smul_smul, ← AddChar.map_add_eq_mul, neg_add_cancel, AddChar.map_zero_eq_one, one_smul]
  have heig : ∀ m ∈ M, ∃ c : ℂ, weyl m ψ = c • ψ := by
    intro m hm
    induction hm using AddSubgroup.closure_induction with
    | mem x hx =>
      obtain ⟨a, ha, rfl⟩ := hx
      exact hgen a ha
    | zero => exact ⟨1, by rw [weyl_zero, one_smul]⟩
    | add u v _ _ hu hv =>
      obtain ⟨cu, hcu⟩ := hu
      obtain ⟨cv, hcv⟩ := hv
      refine ⟨ω (-((2 : ZMod d)⁻¹ * symp u v)) * (cv * cu), ?_⟩
      have h1 := weyl_mul hd u v ψ
      rw [hcv, weyl_smul, hcu, smul_smul] at h1
      rw [mul_smul, h1, smul_smul, ← AddChar.map_add_eq_mul, neg_add_cancel,
        AddChar.map_zero_eq_one, one_smul]
    | neg u _ hu =>
      obtain ⟨cu, hcu⟩ := hu
      have h1 := weyl_neg_weyl hd u ψ
      rw [hcu, weyl_smul] at h1
      have hcu0 : cu ≠ 0 := by
        rintro rfl; rw [zero_smul] at h1; exact hψ h1.symm
      refine ⟨cu⁻¹, ?_⟩
      conv_rhs => rw [← h1]
      rw [smul_smul, inv_mul_cancel₀ hcu0, one_smul]
  -- `M` is isotropic
  have hiso : ∀ u ∈ M, ∀ v ∈ M, symp u v = 0 := by
    intro u hu v hv
    obtain ⟨cu, hcu⟩ := heig u hu
    obtain ⟨cv, hcv⟩ := heig v hv
    have hcu0 : cu ≠ 0 := fun h0 => by
      have := eigen_mul_star hψ hcu; rw [h0, zero_mul] at this; exact zero_ne_one this
    have hcv0 : cv ≠ 0 := fun h0 => by
      have := eigen_mul_star hψ hcv; rw [h0, zero_mul] at this; exact zero_ne_one this
    have h1 := weyl_comm hd u v ψ
    simp only [hcu, hcv, weyl_smul, smul_smul] at h1
    have h2 := smul_cancel hψ h1
    rw [← (char_eq_one_iff (symp u v))]
    have h3 : cv * cu ≠ 0 := mul_ne_zero hcv0 hcu0
    apply mul_right_cancel₀ h3
    linear_combination -1 * h2
  -- the size of `M`
  set F := (univ : Finset (PhaseSpace d n)).filter (fun v => v ∈ M) with hF
  have hcardM : Nat.card M = F.card := by
    rw [Nat.card_eq_fintype_card, Fintype.card_subtype]
  have hlow : d ^ n ≤ F.card := by
    rw [← hScard]
    refine Finset.card_le_card_of_injOn f (fun a ha => ?_) (fun a _ b _ hab => ?_)
    · exact Finset.mem_filter.2 ⟨mem_univ _,
        AddSubgroup.subset_closure (Set.mem_image_of_mem f (Finset.mem_coe.2 ha))⟩
    · have := congrArg (fun v => (2 : ZMod d)⁻¹ • v) hab
      simp only [hf, smul_smul, inv_two_mul_two hd, one_smul] at this
      exact sub_left_injective this
  have hhigh : F.card ≤ d ^ n := by
    set χ : PhaseSpace d n → ℂ := fun v => ∑ x, star (ψ x) * weyl v ψ x with hχ
    have hall : ∑ v, Complex.normSq (χ v) = (d : ℝ) ^ n * N ^ 2 := by
      have h1 := sum_inner_weyl_sq ψ
      rw [sum_star_mul_self] at h1
      have h2 : ((∑ v, Complex.normSq (χ v) : ℝ) : ℂ) = (((d : ℝ) ^ n * N ^ 2 : ℝ) : ℂ) := by
        calc ((∑ v, Complex.normSq (χ v) : ℝ) : ℂ) = ∑ v, χ v * star (χ v) := by
              push_cast; refine Finset.sum_congr rfl fun v _ => ?_
              rw [Complex.normSq_eq_conj_mul_self, mul_comm]; rfl
          _ = (d : ℂ) ^ n * ((N : ℂ) * (N : ℂ)) := h1
          _ = _ := by push_cast; ring
      exact_mod_cast h2
    have hM2 : ∀ v ∈ F, Complex.normSq (χ v) = N ^ 2 := by
      intro v hv
      obtain ⟨c, hc⟩ := heig v (Finset.mem_filter.1 hv).2
      have h1 : χ v = c * N := inner_weyl_of_eigen hc
      have h2 := eigen_mul_star hψ hc
      have h3 : Complex.normSq c = 1 := by
        have : ((Complex.normSq c : ℝ) : ℂ) = 1 := by
          rw [Complex.normSq_eq_conj_mul_self, mul_comm]; exact h2
        exact_mod_cast this
      rw [h1, Complex.normSq_mul, h3, one_mul, Complex.normSq_ofReal]; ring
    have h1 : ∑ v ∈ F, Complex.normSq (χ v) ≤ ∑ v, Complex.normSq (χ v) :=
      Finset.sum_le_sum_of_subset_of_nonneg (subset_univ F)
        (fun _ _ _ => Complex.normSq_nonneg _)
    rw [Finset.sum_congr rfl hM2, Finset.sum_const, nsmul_eq_mul, hall] at h1
    have hN2 : 0 < N ^ 2 := pow_pos hN 2
    have h2 : (F.card : ℝ) ≤ (d : ℝ) ^ n := le_of_mul_le_mul_right h1 hN2
    exact_mod_cast h2
  exact ⟨M, hiso, by rw [hcardM]; exact le_antisymm hhigh hlow, heig⟩

/-! ### Stabilizer implies non-negative -/

omit [NeZero d] in
lemma symp_add_right (a u v : PhaseSpace d n) : symp a (u + v) = symp a u + symp a v := by
  simp only [symp, Prod.fst_add, Prod.snd_add, dotProduct_add]; ring

lemma inner_phasePoint_eq_sum (a : PhaseSpace d n) (ψ : Config d n → ℂ) :
    ∑ x, star (ψ x) * phasePoint a ψ x =
      ((d : ℂ) ^ n)⁻¹ * ∑ b, ω (symp a b) * ∑ x, star (ψ x) * weyl b ψ x := by
  simp only [phasePoint, Finset.mul_sum]
  rw [Finset.sum_comm]
  refine Finset.sum_congr rfl fun b _ => Finset.sum_congr rfl fun x _ => ?_
  ring

/-- Gross's Lemma 9, in the form used here: for a stabilizer state, `W(a) = ‖ψ‖²/d²ⁿ` times a
character sum over `M`, which is `|M|` or `0`. -/
theorem wigner_nonneg_of_isStabilizerState (hd : Odd d) (ψ : Config d n → ℂ) (hψ : ψ ≠ 0)
    (hs : IsStabilizerState ψ) (a : PhaseSpace d n) : 0 ≤ wigner ψ a := by
  classical
  obtain ⟨M, hiso, hcard, heig⟩ := hs
  set N := nsq ψ with hNdef
  have hN : 0 < N := nsq_pos hψ
  have hNc : (N : ℂ) ≠ 0 := by exact_mod_cast hN.ne'
  set χ : PhaseSpace d n → ℂ := fun v => ∑ x, star (ψ x) * weyl v ψ x with hχ
  set F := (univ : Finset (PhaseSpace d n)).filter (fun v => v ∈ M) with hF
  have hFcard : F.card = d ^ n := by
    rw [← hcard, Nat.card_eq_fintype_card, Fintype.card_subtype]
  -- `|χ| = N` on `M`, and `χ = 0` off `M`
  have hM2 : ∀ v ∈ F, Complex.normSq (χ v) = N ^ 2 := by
    intro v hv
    obtain ⟨c, hc⟩ := heig v (Finset.mem_filter.1 hv).2
    have h1 : χ v = c * N := inner_weyl_of_eigen hc
    have h3 : Complex.normSq c = 1 := by
      have : ((Complex.normSq c : ℝ) : ℂ) = 1 := by
        rw [Complex.normSq_eq_conj_mul_self, mul_comm]; exact eigen_mul_star hψ hc
      exact_mod_cast this
    rw [h1, Complex.normSq_mul, h3, one_mul, Complex.normSq_ofReal]; ring
  have hall : ∑ v, Complex.normSq (χ v) = (d : ℝ) ^ n * N ^ 2 := by
    have h1 := sum_inner_weyl_sq ψ
    rw [sum_star_mul_self] at h1
    have h2 : ((∑ v, Complex.normSq (χ v) : ℝ) : ℂ) = (((d : ℝ) ^ n * N ^ 2 : ℝ) : ℂ) := by
      calc ((∑ v, Complex.normSq (χ v) : ℝ) : ℂ) = ∑ v, χ v * star (χ v) := by
            push_cast; refine Finset.sum_congr rfl fun v _ => ?_
            rw [Complex.normSq_eq_conj_mul_self, mul_comm]; rfl
        _ = (d : ℂ) ^ n * ((N : ℂ) * (N : ℂ)) := h1
        _ = _ := by push_cast; ring
    exact_mod_cast h2
  have hoff : ∀ v, v ∉ M → χ v = 0 := by
    have h1 : ∑ v ∈ univ \ F, Complex.normSq (χ v) = 0 := by
      have h2 := Finset.sum_sdiff (s₁ := F) (s₂ := univ) (f := fun v => Complex.normSq (χ v))
        (subset_univ F)
      rw [Finset.sum_congr rfl hM2, Finset.sum_const, nsmul_eq_mul, hFcard, hall] at h2
      push_cast at h2
      linarith
    intro v hv
    have h2 := (Finset.sum_eq_zero_iff_of_nonneg (fun _ _ => Complex.normSq_nonneg _)).1 h1 v
      (Finset.mem_sdiff.2 ⟨mem_univ v, fun h => hv (Finset.mem_filter.1 h).2⟩)
    exact Complex.normSq_eq_zero.1 h2
  -- `χ (m + m') = χ m χ m' / N` on `M`
  have hχmul : ∀ u ∈ M, ∀ v ∈ M, χ (u + v) * N = χ u * χ v := by
    intro u hu v hv
    obtain ⟨cu, hcu⟩ := heig u hu
    obtain ⟨cv, hcv⟩ := heig v hv
    have h1 := weyl_mul hd u v ψ
    rw [hiso u hu v hv, mul_zero, AddChar.map_zero_eq_one, one_smul, hcv, weyl_smul, hcu,
      smul_smul] at h1
    rw [show χ (u + v) = (cv * cu) * N from inner_weyl_of_eigen h1.symm,
      show χ u = cu * N from inner_weyl_of_eigen hcu,
      show χ v = cv * N from inner_weyl_of_eigen hcv]
    ring
  have hχ0 : χ 0 = N := by
    simp only [hχ, weyl_zero, sum_star_mul_self]; rfl
  -- the character
  let φ : AddChar M ℂ :=
    { toFun := fun m => ω (symp a m) * χ m / N
      map_zero_eq_one' := by
        simp only [ZeroMemClass.coe_zero, hχ0]
        rw [show symp a 0 = 0 by simp [symp], AddChar.map_zero_eq_one, one_mul,
          div_self hNc]
      map_add_eq_mul' := by
        intro u v
        simp only [AddMemClass.coe_add, symp_add_right, AddChar.map_add_eq_mul]
        have h1 := hχmul u u.2 v v.2
        field_simp
        linear_combination (ω (symp a u) * ω (symp a v)) * h1 }
  -- `⟨ψ|A(a)|ψ⟩ = N/dⁿ Σ_m φ(m)`
  have hsumM : ∑ b, ω (symp a b) * χ b = N * ∑ m : M, φ m := by
    rw [← Finset.sum_subset (subset_univ F) (fun v _ hv => by
      rw [hoff v (fun h => hv (Finset.mem_filter.2 ⟨mem_univ v, h⟩)), mul_zero])]
    rw [Finset.sum_subtype (p := fun v => v ∈ M) F (fun v => by simp [hF])
      (fun b => ω (symp a b) * χ b),
      Finset.mul_sum]
    refine Finset.sum_congr rfl fun m _ => ?_
    change _ = N * (ω (symp a m) * χ m / N)
    field_simp
  have hφ : ∑ m : M, φ m = (((if φ = 0 then Fintype.card M else 0 : ℕ) : ℝ) : ℂ) := by
    rw [AddChar.sum_eq_ite]; split_ifs <;> simp
  have hw : wigner ψ a = ((((d : ℝ) ^ n)⁻¹ * (((d : ℝ) ^ n)⁻¹ *
      (N * ((if φ = 0 then Fintype.card M else 0 : ℕ) : ℝ))) : ℝ) : ℂ) := by
    rw [wigner, inner_phasePoint_eq_sum, hsumM, hφ]
    push_cast; rfl
  rw [hw, Complex.zero_le_real]
  have hdn : (0 : ℝ) ≤ ((d : ℝ) ^ n)⁻¹ := inv_nonneg.2 (pow_nonneg (Nat.cast_nonneg d) n)
  exact mul_nonneg hdn (mul_nonneg hdn (mul_nonneg hN.le (Nat.cast_nonneg _)))

end DiscreteHudson
